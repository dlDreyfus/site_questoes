# Copie para .env e preencha. Para gerar uma chave nova:
# python -c "from django.core.management.utils import get_random_secret_key as g; print(g())"
DJANGO_SECRET_KEY=

# True só em desenvolvimento; sem esta variável, o padrão é False (produção)
DJANGO_DEBUG=True

# Domínio(s) do site separados por vírgula, ex: meusite.pythonanywhere.com
# Em desenvolvimento (DEBUG=True) pode ficar vazio; sem a variável, usa dlDreyfus.pythonanywhere.com
DJANGO_ALLOWED_HOSTS=

# E-mail (recuperação de senha). Com EMAIL_HOST vazio, os e-mails só aparecem no terminal do runserver.
# Gmail: smtp.gmail.com, porta 587, a conta como usuário e uma "senha de app" de 16 letras
# (https://myaccount.google.com/apppasswords, exige verificação em duas etapas), nunca a senha normal
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
# Remetente; no Gmail precisa ser a própria conta, ex: Simulado <meusite@gmail.com>
DJANGO_DEFAULT_FROM_EMAIL=