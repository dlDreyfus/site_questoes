# Copie para .env e preencha. Para gerar uma chave nova:
# python -c "from django.core.management.utils import get_random_secret_key as g; print(g())"
DJANGO_SECRET_KEY=

# Em produção, defina False
DJANGO_DEBUG=True

# Em produção, domínio(s) do site separados por vírgula, ex: meusite.pythonanywhere.com
DJANGO_ALLOWED_HOSTS=
